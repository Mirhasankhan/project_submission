datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  email         String         @unique
  password      String
  role          UserRole       @default(Student)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  submissions   Submission[]

  @@map("users")
}

enum UserRole {
  Student
  Mentor
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique // stores SHA-256 hash
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Submission {
  id             String @id @default(uuid())
  projectName    String @db.VarChar(50)
  repositoryUrl  String @db.VarChar(100)
  normalizedRepo String @db.VarChar(100)
  liveUrl        String @db.VarChar(100)
  description    String @db.VarChar(1000)

  status SubmissionStatus @default(Pending)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  reviewedAt      DateTime?
  rejectionReason String?   @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, projectName])
  @@unique([studentId, normalizedRepo])
  @@index([status, createdAt])
  @@index([studentId, createdAt])
}

enum SubmissionStatus {
  Pending
  Rejected
  Approved
}
