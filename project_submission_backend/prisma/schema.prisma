generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id @default(uuid())
  fullName    String
  email       String       @unique
  password    String
  role        UserRole     @default(Student)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]

  @@map("users")
}

enum UserRole {
  Student
  Mentor
}

model Submission {
  id             String @id @default(uuid())
  projectName    String @db.VarChar(50)
  repositoryUrl  String @db.VarChar(100)
  normalizedRepo String @db.VarChar(100)
  liveUrl        String @db.VarChar(100)
  description    String @db.VarChar(1000)

  status SubmissionStatus @default(Pending)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  reviewedAt      DateTime?
  rejectionReason String?   @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, projectName])
  @@unique([studentId, normalizedRepo])
  @@index([status, createdAt])
  @@index([studentId, createdAt])
}

enum SubmissionStatus {
  Pending
  Rejected
  Approved
}
